# CampusMate Frontend Environment Variables
# Copy this file to .env and fill in the values.

# Backend API URL
VITE_API_URL=http://127.0.0.1:8000

# ─── TTS Provider ───────────────────────────────────────────────────────────────
# Options: responsivevoice | google | azure | browser
# - responsivevoice : Free cloud TTS. Best Tamil quality without any API key.
# - google          : Google Cloud Neural TTS (requires VITE_GOOGLE_TTS_KEY).
# - azure           : Azure Cognitive Neural TTS (requires VITE_AZURE_TTS_KEY).
# - browser         : Use browser's local voice only (no cloud fallback).
VITE_TTS_PROVIDER=responsivevoice

# ─── Google Cloud Text-to-Speech (Optional) ─────────────────────────────────────
# Get your key: https://console.cloud.google.com/apis/api/texttospeech.googleapis.com
# Tamil voice: ta-IN-Neural2-A
# English voice: en-IN-Neural2-A
VITE_GOOGLE_TTS_KEY=

# ─── Azure Cognitive Speech (Optional) ──────────────────────────────────────────
# Get your key: https://portal.azure.com/#view/Microsoft_Azure_ProjectOxford/CognitiveServicesHub
# Tamil voice: ta-IN-PallaviNeural
# English voice: en-IN-NeerjaNeural
VITE_AZURE_TTS_KEY=
VITE_AZURE_TTS_REGION=eastus
