# production.env.example
APP_NAME="CollegeMate AI"
ENV="production"
HOST="0.0.0.0"
PORT=8000
API_V1_STR="/api/v1"

# Security (MUST BE CHANGED)
SECRET_KEY="your-production-secret-key-must-be-very-secure"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS="https://your-production-domain.com"

# Database
# Example: DATABASE_URL="postgresql://user:password@db_host:5432/collegemate"
DATABASE_URL="sqlite:///./database/campusmate.db"

# AI & RAG
GEMINI_API_KEY="your-production-gemini-api-key"
CHROMA_DB_DIR="./chroma_db"
DOCUMENTS_DIR="./documents"

# File Uploads
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE=10485760
