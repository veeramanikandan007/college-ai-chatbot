# CampusMate Environment Variables

# Application Settings
APP_NAME=CampusMate AI
ENV=development
HOST=127.0.0.1
PORT=8000
API_V1_STR=/api/v1

# Security
# Generate a secret key: openssl rand -hex 32
SECRET_KEY=replace-with-a-very-long-secret-key-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite:///./database/campusmate.db

# AI & RAG
GEMINI_API_KEY=REDACTED_GEMINI_API_KEY
CHROMA_DB_DIR=./chroma_db
DOCUMENTS_DIR=./documents

# File Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760 # 10MB
