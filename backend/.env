
# ==========================================
# CampusMate AI Configuration
# ==========================================
APP_NAME=CampusMate AI
ENV=development
HOST=127.0.0.1
PORT=8000
API_V1_STR=/api/v1

# ==========================================
# Security & JWT
# ==========================================
SECRET_KEY=replace-with-a-very-long-secret-key-for-production
JWT_SECRET=replace-with-a-very-long-secret-key-for-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==========================================
# Database
# ==========================================
DATABASE_URL=sqlite:///./database/campusmate.db

# ==========================================
# AI & RAG
# ==========================================
GEMINI_API_KEY=REDACTED_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=REDACTED_GROQ_API_KEY
GROQ_MODEL=llama-3.3-70b-versatile
CHROMA_DB_DIR=./chroma_db
DOCUMENTS_DIR=./documents

# ==========================================
# File Uploads
# ==========================================
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760

