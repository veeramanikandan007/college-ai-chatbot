# =============================================================
# CampusMate — Production .gitignore
# Covers: Python, FastAPI, React, Node, Vite, SQLite, PostgreSQL,
#         Environment files, Build artifacts, Logs, OS files
# =============================================================

# ── Python ────────────────────────────────────────────────────
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.log
pip-log.txt
pip-delete-this-directory.txt

# ── Virtual Environments ──────────────────────────────────────
.venv/
venv/
env/
ENV/
.env.bak

# ── Environment & Secrets ─────────────────────────────────────
.env
.env.*
!.env.example
!.env.*.example
!development.env.example
!production.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# ── Databases ─────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
**/database/*.db
database/

# ── AI / Vector DB ────────────────────────────────────────────
vector_db/
**/vector_db/
chroma_db/
**/chroma_db/
.chroma/
documents/
uploads/

# ── Node / React / Vite ───────────────────────────────────────
node_modules/
**/node_modules/
dist/
**/dist/
.vite/
**/.vite/
frontend/dist/
frontend/build/
*.local
.eslintcache

# ── Build Artifacts ───────────────────────────────────────────
*.min.js
*.min.css
*.map
*.tsbuildinfo

# ── Logs ──────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── OS & Editor ───────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# ── Alembic ───────────────────────────────────────────────────
alembic/__pycache__/
alembic/versions/__pycache__/

# ── Misc ──────────────────────────────────────────────────────
*.bak
*.tmp
ttsService_backup2.ts

tore .git restore .
